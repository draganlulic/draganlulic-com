---
import Base from "../layouts/Base.astro";

const title = "Message sent | Dragan Lulić";
const description = "Thanks for reaching out. I'll get back to you within a day.";
---

<Base title={title} description={description} noindex>
  <section class="border-b border-line">
    <div class="container-wide flex min-h-[50vh] flex-col items-start justify-center py-20">
      <p class="eyebrow mb-3">Thank you</p>
      <h1 class="text-4xl leading-[1.05] sm:text-5xl">Message sent</h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">
        Thanks for reaching out. I reply within a day, usually sooner.
      </p>
      <a href="/" class="btn btn-primary mt-8">Back to homepage</a>
    </div>
  </section>
</Base>
